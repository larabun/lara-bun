{
    "name": "rsc-kit/laravel",
    "description": "React Server Components for Laravel, rendered by a JavaScript runtime over a local socket",
    "type": "library",
    "keywords": [
        "laravel",
        "react",
        "rsc",
        "react-server-components",
        "ssr",
        "streaming"
    ],
    "homepage": "https://github.com/rsc-kit/laravel",
    "authors": [
        {
            "name": "Ramon Malcolm",
            "homepage": "https://github.com/ramonmalcolm10"
        }
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "illuminate/console": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "mockery/mockery": "^1.6",
        "laravel/pint": "^1.24"
    },
    "autoload": {
        "psr-4": {
            "RscKit\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint",
        "lint:dirty": "vendor/bin/pint --dirty"
    },
    "extra": {
        "laravel": {
            "providers": [
                "RscKit\\RscKitServiceProvider"
            ],
            "aliases": {
                "Rsc": "RscKit\\Facades\\Rsc"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
